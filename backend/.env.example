# ============================================
# Backend Environment Variables (Render par set karni hain)
# ============================================

PORT=5001

# MongoDB Atlas connection string (already Atlas hai, same use karo)
MONGO_URI=your_mongodb_atlas_connection_string

# JWT Secrets (kisi bhi random lambi string se generate kar sakti hain)
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRES_IN=1d

# Email (Gmail App Password use karein, normal password nahi)
EMAIL_USER=your_gmail_address
EMAIL_PASS=your_gmail_app_password

# Deployment ke baad ye 2 cheezein UPDATE karni hain:
# ALLOWED_ORIGINS = aapki Vercel frontend URL (comma separated agar multiple hon)
# FRONTEND_URL = same Vercel URL (email links ke liye use hota hai)
ALLOWED_ORIGINS=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

NODE_ENV=production
