# ============================================
# Frontend Environment Variables (Vercel par set karni hain)
# ============================================

# Backend deploy hone ke baad, Render se mili hui URL yahan daalni hai
# Zaroori: /api ke sath (jaisa neeche example mein hai)
REACT_APP_API_URL=https://your-backend.onrender.com/api

# Same backend URL, lekin BINA /api ke (images/uploads/sockets ke liye)
REACT_APP_SERVER_URL=https://your-backend.onrender.com
